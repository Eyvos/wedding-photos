# Copier ce fichier en .env.local pour le développement local.
# En production, ces variables se saisissent dans Vercel > Settings > Environment Variables.
# La procédure complète pour les obtenir est dans SETUP.md.

# --- Dropbox (secrets — jamais exposés au navigateur) ---------------------
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# --- Site (public) --------------------------------------------------------
# L'URL définitive du site, pour les aperçus quand le lien est partagé.
# Sur Vercel, mettre le domaine de production, sans slash final.
NEXT_PUBLIC_SITE_URL=https://photos-alex-et-seve.vercel.app
